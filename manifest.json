{
  "manifest_version": 3,
  "name": "DCInside ShortCut",
  "version": "0.4.3",
  "description": "디시인사이드 단축키 추가, 즐겨찾는 갤러리 단축키 기능",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-favorites": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "즐겨찾기 창 열기/닫기"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dcinside.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "dc-content.css",
        "content-script.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "commands",
    "scripting",
    "activeTab"
  ]
}
